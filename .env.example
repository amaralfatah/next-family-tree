# Database. Neon in production; any Postgres locally. Leave empty to use embedded PGlite (.data/pglite).
DATABASE_URL=

# Use the direct (non-pooled) URL for `npm run db:migrate`. Written by `neon deploy`.
DATABASE_URL_UNPOOLED=

# Google sign-in via Neon Auth (Managed Better Auth). NEON_AUTH_BASE_URL is written by `neon deploy`;
# generate the cookie secret with `openssl rand -base64 32`. Leave empty to offer only the test login.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Cloudflare R2 for photos. Leave empty to store photos in .data/uploads (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set to 1 to allow the password-less test login outside development. Never on a real deployment.
ALLOW_DEV_LOGIN=
