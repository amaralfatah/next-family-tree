# Database. Neon in production; any Postgres locally. Leave empty to use embedded PGlite (.data/pglite).
DATABASE_URL=

# Public base URL, used for the Google OAuth callback (defaults to the request origin).
APP_URL=

# Google sign-in (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for photos. Leave empty to store photos in .data/uploads (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set to 1 to allow the password-less test login outside development. Never on a real deployment.
ALLOW_DEV_LOGIN=
